{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "minItems": 1
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "single",
            "row",
            "group",
            "whole"
          ]
        },
        "id_field": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "group_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "not": {
            "const": "__request__"
          }
        }
      },
      "required": [
        "mode"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "row"
              }
            }
          },
          "then": {
            "required": [
              "id_field"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "group"
              }
            }
          },
          "then": {
            "required": [
              "group_by"
            ]
          }
        }
      ]
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "field": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "date",
              "datetime"
            ]
          },
          "empty": {
            "enum": [
              "preserve",
              "null"
            ]
          },
          "null_tokens": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "true_values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "false_values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "date_format": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "source",
          "field",
          "type",
          "empty"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "boolean"
                }
              }
            },
            "then": {
              "required": [
                "true_values",
                "false_values"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "date",
                    "datetime"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "date_format"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "description": "결정 장부. 사람이 확정한 판단을 기록·재사용한다. 고객별 1개.",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$",
                "description": "대상(subject) 기준 JSON Pointer. 문자열 state면 \"\""
              },
              "normalize": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "nfkc",
                    "trim",
                    "collapse_spaces",
                    "lower",
                    "alpha_prefix"
                  ]
                }
              }
            },
            "required": [
              "pointer"
            ]
          }
        }
      },
      "required": [
        "path",
        "keys"
      ]
    }
  },
  "required": [
    "policy",
    "questions",
    "unit"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wim-choose customer configuration",
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "prohibitions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "as_of": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "rules"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "not": {
            "const": "__request__"
          }
        },
        "type": {
          "enum": [
            "choice",
            "predicate",
            "score"
          ]
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "value",
              "meaning"
            ]
          },
          "minItems": 1
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "score": {
                "type": "number"
              },
              "criteria": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "score",
              "criteria"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "type",
        "instructions"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "rubric"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "predicate"
              }
            }
          },
          "then": {
            "required": [],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "choices"
                  ]
                },
                {
                  "required": [
                    "rubric"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "score"
              }
            }
          },
          "then": {
            "required": [
              "rubric"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "choices"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
